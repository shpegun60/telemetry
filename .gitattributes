* text=auto

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# build.py compares TypeScript output byte-for-byte on every supported host.
lib/client/web/Client.js text eol=lf
lib/client/web/Client.d.ts text eol=lf

# Preserve upstream bytes documented in each dependency's README.md.
lib/delegate/tiny_delegate.hpp -text
lib/delegate/LICENSE -text
lib/magic_enum/magic_enum.hpp -text
lib/magic_enum/LICENSE -text

# Measurement CSV hashes refer to exact retained bytes.
tests/position_tables/h7s/samples.csv -text whitespace=cr-at-eol

# Preserve original receipt/log bytes, whitespace and retained SHA-256 identities.
doc/evidence/inspector-serial-h7s-2026-10-28/** -text -whitespace

# Keep the public qualification manifest valid across checkout line endings.
doc/evidence/read-many-uart-load-2026-11-02/** -text whitespace=cr-at-eol
