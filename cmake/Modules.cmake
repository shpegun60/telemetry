    endforeach()
    list(REMOVE_DUPLICATES _telemetry_selected)
endforeach()

# Resolve existing ancestors too: REAL_PATH alone leaves a missing leaf's
# intermediate symlinks unresolved. Use the same guard during installation.
set(_telemetry_path_guard [=[
# Translate supported Windows link names without consulting a remote filesystem.
function(_telemetry_windows_link_target link parent result)
    string(REPLACE "\\" "/" _link "${link}")
    string(SUBSTRING "${_link}" 0 4 _lead)
    if(_lead STREQUAL "/??/" OR _lead STREQUAL "//?/")
        string(SUBSTRING "${_link}" 4 -1 _link)
        if(_link MATCHES "^UNC/")
            string(SUBSTRING "${_link}" 4 -1 _link)
            set(_link "//${_link}")
        elseif(NOT _link MATCHES "^[A-Za-z]:/")
            message(FATAL_ERROR "Module output must stay inside its owning directory; unsupported NT link target: ${link}")
        endif()
    elseif(_link MATCHES "^//[.]/" OR _link MATCHES "^[A-Za-z]:($|[^/])" OR
           (_link MATCHES "^/" AND NOT _link MATCHES "^//[^/]+/[^/]+"))
        message(FATAL_ERROR "Module output must stay inside its owning directory; unsupported link target: ${link}")
    endif()
    cmake_path(SET _link NORMALIZE "${_link}")
    cmake_path(ABSOLUTE_PATH _link BASE_DIRECTORY "${parent}" NORMALIZE OUTPUT_VARIABLE _resolved)
    set(${result} "${_resolved}" PARENT_SCOPE)
endfunction()

# CMake REAL_PATH does not expand Windows directory junctions on every supported
# host. Expand each link component explicitly, including before an existing leaf.
function(_telemetry_windows_links path result)
    cmake_path(SET _pending NORMALIZE "${path}")
    cmake_path(ABSOLUTE_PATH _pending NORMALIZE)
    set(_seen "")
    foreach(_expansion RANGE 0 63)
        list(FIND _seen "${_pending}" _previous)
        if(NOT _previous EQUAL -1 OR _pending MATCHES ";")
            message(FATAL_ERROR "Module output must stay inside its owning directory; cyclic or unsupported link path: ${path}")
        endif()
        list(APPEND _seen "${_pending}")
        cmake_path(GET _pending ROOT_PATH _prefix)
        cmake_path(GET _pending RELATIVE_PART _tail)
        string(REPLACE "/" ";" _components "${_tail}")
        set(_restart FALSE)
        while(NOT "${_components}" STREQUAL "")
            list(POP_FRONT _components _component)
            set(_parent "${_prefix}")
            cmake_path(APPEND _prefix "${_component}")
            if(IS_SYMLINK "${_prefix}")
                if(NOT EXISTS "${_prefix}")
                    message(FATAL_ERROR "Module output must stay inside its owning directory; dangling or cyclic link: ${_prefix}")
                endif()
                file(READ_SYMLINK "${_prefix}" _link)
                _telemetry_windows_link_target("${_link}" "${_parent}" _pending)
                foreach(_remaining IN LISTS _components)
                    cmake_path(APPEND _pending "${_remaining}")
                endforeach()
                set(_restart TRUE)
                break()
            endif()
        endwhile()
        if(NOT _restart)
            set(${result} "${_pending}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Module output must stay inside its owning directory; too many link expansions: ${path}")
endfunction()

function(_telemetry_real_output path result)
    if(CMAKE_HOST_WIN32)
        _telemetry_windows_links("${path}" path)
    endif()
    cmake_path(ABSOLUTE_PATH path NORMALIZE OUTPUT_VARIABLE _ancestor)
    cmake_path(GET _ancestor ROOT_PATH _root)
    if(NOT _ancestor STREQUAL _root)
        string(REGEX REPLACE "/+$" "" _ancestor "${_ancestor}")
    endif()
    set(_suffix "")
    while(NOT EXISTS "${_ancestor}")
        if(IS_SYMLINK "${_ancestor}")
            message(FATAL_ERROR "Module output must stay inside its owning directory; dangling symlink: ${_ancestor}")
        endif()
        get_filename_component(_name "${_ancestor}" NAME)
        get_filename_component(_parent "${_ancestor}" DIRECTORY)
        if(_parent STREQUAL _ancestor)
            message(FATAL_ERROR "Cannot resolve module output directory: ${path}")
        endif()
        set(_suffix "/${_name}${_suffix}")
        set(_ancestor "${_parent}")
    endwhile()
    file(REAL_PATH "${_ancestor}" _resolved)
    set(${result} "${_resolved}${_suffix}" PARENT_SCOPE)
endfunction()

function(_telemetry_require_owned_path owner target description)
    _telemetry_real_output("${owner}" _owner_real)
    _telemetry_real_output("${target}" _target_real)
    cmake_path(IS_PREFIX _owner_real "${_target_real}" NORMALIZE _inside)
    if(NOT _inside OR _target_real STREQUAL _owner_real)
        message(FATAL_ERROR "${description} must stay inside its owning directory: ${owner}")
    endif()
endfunction()
]=])
cmake_language(EVAL CODE "${_telemetry_path_guard}")
# CMake's generated preamble strips a trailing slash, including from root
# prefixes. Restore those sentinels before normalizing the actual variables
# consumed by every subsequent cleanup, file(INSTALL), export and license rule.
install(CODE [=[
    # Telemetry install-path normalization begin.
    if(CMAKE_INSTALL_PREFIX STREQUAL "")
        set(CMAKE_INSTALL_PREFIX "/")
    elseif(CMAKE_HOST_WIN32 AND CMAKE_INSTALL_PREFIX MATCHES "^[A-Za-z]:$")
        string(APPEND CMAKE_INSTALL_PREFIX "/")
    endif()
    cmake_path(SET CMAKE_INSTALL_PREFIX NORMALIZE "${CMAKE_INSTALL_PREFIX}")
    cmake_path(ABSOLUTE_PATH CMAKE_INSTALL_PREFIX NORMALIZE)
    # file(INSTALL) appends its own slash. Keep CMake's root representation
    # after normalization, otherwise "/" plus "/include" becomes a network path.
    string(REGEX REPLACE "/$" "" CMAKE_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
    if(NOT "$ENV{DESTDIR}" STREQUAL "")
        cmake_path(SET _telemetry_destdir NORMALIZE "$ENV{DESTDIR}")
        cmake_path(ABSOLUTE_PATH _telemetry_destdir NORMALIZE)
        set(ENV{DESTDIR} "${_telemetry_destdir}")
    endif()
    # Telemetry install-path normalization end.
]=])
install(CODE "${_telemetry_path_guard}")

# Copy only a component's public headers; never export the repository's lib root.
function(telemetry_headers target module prefix source)
    set(_stage "${CMAKE_CURRENT_BINARY_DIR}/module-headers/${module}")
    file(GLOB_RECURSE _headers CONFIGURE_DEPENDS RELATIVE "${source}"
        "${source}/*.hpp" "${source}/*.h")
    foreach(_header IN LISTS _headers)
        if(module STREQUAL "core" AND _header MATCHES "^(client|protocol|runtime)/")
            continue()
        endif()
        if(module STREQUAL "resource" AND _header MATCHES "^(telemetry|protocol)/")
            continue()
        endif()
        get_filename_component(_parent "${_stage}/${prefix}/${_header}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        configure_file("${source}/${_header}" "${_stage}/${prefix}/${_header}" COPYONLY)
    endforeach()
    target_include_directories(${target} INTERFACE
        $<BUILD_INTERFACE:${_stage}>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/telemetry-${module}>)
    install(DIRECTORY "${_stage}/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/telemetry-${module}")
endfunction()

function(telemetry_header target module path relative)
    set(_stage "${CMAKE_CURRENT_BINARY_DIR}/module-headers/${module}")
    get_filename_component(_parent "${_stage}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    configure_file("${PROJECT_SOURCE_DIR}/${path}" "${_stage}/${relative}" COPYONLY)
    target_include_directories(${target} INTERFACE
        $<BUILD_INTERFACE:${_stage}>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/telemetry-${module}>)
    get_filename_component(_relative_parent "${relative}" DIRECTORY)
    install(FILES "${_stage}/${relative}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/telemetry-${module}/${_relative_parent}")
endfunction()

function(telemetry_integration_header target module header)
    telemetry_header(${target} ${module} lib/integration/telemetry/v3/${header} integration/telemetry/v3/${header})
endfunction()

foreach(_module IN LISTS _telemetry_modules)
    if(NOT _module IN_LIST _telemetry_selected)
        continue()
    endif()
    set(_target telemetry_${_module})
    set(_stage "${CMAKE_CURRENT_BINARY_DIR}/module-headers/${_module}")
    get_filename_component(_stage_absolute "${_stage}" ABSOLUTE)
    _telemetry_require_owned_path("${CMAKE_CURRENT_BINARY_DIR}" "${_stage_absolute}" "Module header staging")
    file(REMOVE_RECURSE "${_stage_absolute}")
    # Each module exclusively owns this install subdirectory. An upgrade must
    # not retain removed public headers from an earlier version.
    install(CODE "
        set(_module_prefix \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/\")
        set(_module_headers \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_INCLUDEDIR}/telemetry-${_module}\")
        cmake_path(ABSOLUTE_PATH _module_prefix NORMALIZE OUTPUT_VARIABLE _module_prefix)
        cmake_path(ABSOLUTE_PATH _module_headers NORMALIZE OUTPUT_VARIABLE _module_headers)
        _telemetry_require_owned_path(\"\${_module_prefix}\" \"\${_module_headers}\" \"Module headers\")
        file(REMOVE_RECURSE \"\${_module_headers}\")
    ")
    if(_module STREQUAL "core")
        add_library(${_target} STATIC lib/telemetry/abi/StructuredAbi.cpp lib/telemetry/model/Adapter.cpp)
    elseif(_module STREQUAL "resource_protocol")
        add_library(${_target} STATIC lib/resource/protocol/Protocol.cpp)
    elseif(_module STREQUAL "resource_adapter")
        add_library(${_target} STATIC lib/integration/telemetry/v3/detail/Values.cpp)
    elseif(_module STREQUAL "encoded_server")
        add_library(${_target} STATIC lib/integration/encoded/Dispatcher.cpp)
    elseif(_module STREQUAL "rpc_server")
        add_library(${_target} STATIC lib/integration/telemetry/v3/RpcMailbox.cpp)
    elseif(_module STREQUAL "rpc_client")
        add_library(${_target} STATIC lib/client/rpc/RpcClient.cpp)
    else()
        add_library(${_target} INTERFACE)
    endif()
    set_target_properties(${_target} PROPERTIES EXPORT_NAME ${_module})
    add_library(Telemetry::${_module} ALIAS ${_target})
    target_compile_features(${_target} INTERFACE cxx_std_20)
    foreach(_dependency IN LISTS _telemetry_deps_${_module})
        target_link_libraries(${_target} INTERFACE telemetry_${_dependency})
    endforeach()
    get_target_property(_type ${_target} TYPE)
    if(NOT _type STREQUAL "INTERFACE_LIBRARY")
        target_compile_features(${_target} PRIVATE cxx_std_20)
        # Consume exactly the same public include roots used by downstreams.
        target_include_directories(${_target} PRIVATE $<TARGET_PROPERTY:${_target},INTERFACE_INCLUDE_DIRECTORIES>)
        foreach(_dependency IN LISTS _telemetry_deps_${_module})
            target_link_libraries(${_target} PRIVATE telemetry_${_dependency})
        endforeach()
    endif()
    if(_module STREQUAL "delegate")
        telemetry_header(${_target} ${_module} lib/delegate/tiny_delegate.hpp delegate/tiny_delegate.hpp)
    elseif(_module STREQUAL "common")
        telemetry_headers(${_target} ${_module} common "${PROJECT_SOURCE_DIR}/lib/common")
    elseif(_module STREQUAL "reflection")
        telemetry_headers(${_target} ${_module} boost "${PROJECT_SOURCE_DIR}/lib/boost_pfr/include/boost")
        telemetry_header(${_target} ${_module} lib/magic_enum/magic_enum.hpp magic_enum.hpp)
    elseif(_module STREQUAL "core")
        telemetry_headers(${_target} ${_module} telemetry "${PROJECT_SOURCE_DIR}/lib/telemetry")
    elseif(_module STREQUAL "runtime")
        telemetry_headers(${_target} ${_module} telemetry/runtime "${PROJECT_SOURCE_DIR}/lib/telemetry/runtime")
        foreach(_header descriptor/Format.hpp type/WireTypes.hpp)
            telemetry_header(${_target} ${_module} lib/telemetry/${_header} telemetry/${_header})
        endforeach()
    elseif(_module STREQUAL "dynamic_client")
        telemetry_headers(${_target} ${_module} integration/dynamic "${PROJECT_SOURCE_DIR}/lib/integration/dynamic")
    elseif(_module STREQUAL "inspector")
        telemetry_headers(${_target} ${_module} integration/inspector "${PROJECT_SOURCE_DIR}/lib/integration/inspector")
    elseif(_module STREQUAL "workbench")
        telemetry_headers(${_target} ${_module} integration/workbench "${PROJECT_SOURCE_DIR}/lib/integration/workbench")
    elseif(_module STREQUAL "tcp_server")
        telemetry_headers(${_target} ${_module} integration/tcp "${PROJECT_SOURCE_DIR}/lib/integration/tcp")
    elseif(_module STREQUAL "codec")
        foreach(_part codec reflection result)
            telemetry_headers(${_target} ${_module} telemetry/${_part} "${PROJECT_SOURCE_DIR}/lib/telemetry/${_part}")
        endforeach()
        foreach(_header type/Traits.hpp type/WireTypes.hpp core/Compiler.hpp slot/TelemetrySlotTraits.h)
            telemetry_header(${_target} ${_module} lib/telemetry/${_header} telemetry/${_header})
        endforeach()
    elseif(_module STREQUAL "resource")
        telemetry_headers(${_target} ${_module} resource "${PROJECT_SOURCE_DIR}/lib/resource")
    elseif(_module STREQUAL "resource_protocol")
        telemetry_header(${_target} ${_module} lib/resource/protocol/Protocol.hpp resource/protocol/Protocol.hpp)
    elseif(_module STREQUAL "resource_wire")
        foreach(_header Wire.hpp Packets.hpp)
            telemetry_header(${_target} ${_module} lib/resource/protocol/${_header} resource/protocol/${_header})
        endforeach()
    elseif(_module STREQUAL "client")
        foreach(_header Backend.hpp ClientResult.hpp DeviceClient.hpp RequestQueue.hpp ThreadSafeClient.hpp)
            telemetry_header(${_target} ${_module} lib/client/${_header} client/${_header})
        endforeach()
    elseif(_module STREQUAL "encoded_wire")
        telemetry_header(${_target} ${_module} lib/wire/EncodedWire.hpp wire/EncodedWire.hpp)
    elseif(_module STREQUAL "rpc_wire")
        telemetry_header(${_target} ${_module} lib/wire/RpcWire.hpp wire/RpcWire.hpp)
    elseif(_module STREQUAL "encoded_backend")
        telemetry_header(${_target} ${_module} lib/integration/encoded/Backend.hpp integration/encoded/Backend.hpp)
        telemetry_header(${_target} ${_module} lib/integration/encoded/RetryingBackend.hpp integration/encoded/RetryingBackend.hpp)
    elseif(_module STREQUAL "rpc_backend")
        telemetry_header(${_target} ${_module} lib/integration/rpc/Backend.hpp integration/rpc/Backend.hpp)
    elseif(_module STREQUAL "rpc_client")
        telemetry_headers(${_target} ${_module} client/rpc "${PROJECT_SOURCE_DIR}/lib/client/rpc")
    elseif(_module STREQUAL "encoded_server")
        telemetry_header(${_target} ${_module} lib/integration/encoded/Dispatcher.hpp integration/encoded/Dispatcher.hpp)
    elseif(_module STREQUAL "rpc_server")
        telemetry_integration_header(${_target} ${_module} RpcMailbox.hpp)
    elseif(_module STREQUAL "rpc_sessions")
        telemetry_integration_header(${_target} ${_module} RpcSessionPool.hpp)
    elseif(_module STREQUAL "resource_adapter")
        foreach(_header DescriptorFile.hpp ValuesFile.hpp ValuesFormat.hpp detail/Values.hpp detail/DescriptorRead.hpp)
            telemetry_integration_header(${_target} ${_module} ${_header})
        endforeach()
    endif()
    install(TARGETS ${_target} EXPORT TelemetryTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
endforeach()
